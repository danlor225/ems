# ==========================================================
#  EMS - Modèle de variables d'environnement
#  Copie ce fichier en ".env" et remplis les vraies valeurs.
#  Le vrai ".env" est ignoré par Git (voir .gitignore) -> aucun secret n'est commité.
# ==========================================================

# ---------- Base de données PostgreSQL ----------
POSTGRES_USER=ems_user
POSTGRES_PASSWORD=change_me_in_real_env
POSTGRES_DB=ems_db
POSTGRES_PORT=5432

# URL de connexion utilisée par Prisma.
# Format : postgresql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/BASE?schema=public
# En DEV, le backend tourne sur l'hôte => HOTE = localhost.
# Quand le backend sera conteneurisé, HOTE deviendra "postgres" (nom du service Docker).
DATABASE_URL=postgresql://ems_user:change_me_in_real_env@localhost:5432/ems_db?schema=public

# ---------- Backend (NestJS) ----------
BACKEND_PORT=3000
NODE_ENV=development

# ---------- Sécurité / JWT ----------
# Secrets longs et aléatoires en production (ex: openssl rand -hex 32).
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Frontend (Vite / React) ----------
FRONTEND_PORT=5173
# URL de l'API vue par le navigateur (préfixe VITE_ obligatoire pour être exposée au front).
VITE_API_URL=http://localhost:3000/api
